
<Window x:Class="RoomSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Selector"
        Height="550"
        Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Room Selector"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#263445"/>

            <TextBlock Text="Select rooms from the current level"
                       FontSize="12"
                       Foreground="#7B8794"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Height="34"
                     Padding="10,5"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     ToolTip="Search Room Number or Name"/>

            <TextBlock x:Name="CountText"
                       Grid.Column="1"
                       Text="0 Rooms"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"
                       Foreground="#64748B"/>
        </Grid>

        <!-- Room Table -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DCE2E9"
                BorderThickness="1"
                CornerRadius="6">

            <DataGrid x:Name="RoomGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      SelectionMode="Extended"
                      RowHeight="38"
                      ColumnHeaderHeight="38">

                <DataGrid.Columns>

                    <DataGridCheckBoxColumn
                        Header="Select"
                        Binding="{Binding IsSelected,
                        UpdateSourceTrigger=PropertyChanged}"
                        Width="65"/>

                    <DataGridTextColumn
                        Header="Number"
                        Binding="{Binding Number}"
                        IsReadOnly="True"
                        Width="100"/>

                    <DataGridTextColumn
                        Header="Room Name"
                        Binding="{Binding Name}"
                        IsReadOnly="True"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Level"
                        Binding="{Binding Level}"
                        IsReadOnly="True"
                        Width="130"/>

                    <DataGridTextColumn
                        Header="Area (m²)"
                        Binding="{Binding Area}"
                        IsReadOnly="True"
                        Width="90"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SelectedText"
                       Text="Selected: 0"
                       VerticalAlignment="Center"
                       Foreground="#64748B"/>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    Width="90"
                    Height="34"
                    Margin="0,0,8,0"/>

            <Button x:Name="OKButton"
                    Grid.Column="2"
                    Content="OK"
                    Width="90"
                    Height="34"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
